# CrossPanel Production & Development Configuration Template
# Copy this file to .env and adjust values for your deployment.

# ==========================================
# Security & App Settings
# ==========================================
PROJECT_NAME="CrossPanel"
VERSION="1.0.0"
DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-key-here-for-production

# ==========================================
# Database Configuration
# ==========================================
# SQLite (Default):
DATABASE_URL="sqlite+aiosqlite:///./data/crosspanel.db"
# PostgreSQL (Optional for large production clusters):
# DATABASE_URL="postgresql+asyncpg://crosspanel_user:strong_password@localhost:5432/crosspanel"

# ==========================================
# Server & Port Bindings
# ==========================================
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api"

# ==========================================
# Multi-OS Abstraction Layer
# ==========================================
# auto | windows | linux | mac
HOST_OS="auto"
TARGET_OS="auto"

# ==========================
# DevOps & Tools Ports
# ==========================
PHPMYADMIN_PORT=888
TERMINAL_ENABLED=true

# ==========================
# Frontend Configuration
# ==========================
VITE_API_URL="/api"
